{
  "schema_version": 1,
  "environment": "backend.fly_env.FlyTypingEnv",
  "mode": "state_assisted_physics_body",
  "claim": "NeuroMechFly legs in MuJoCo press spring-loaded keys; policy commands walking velocity and reach targets for both forelegs, given the next key's offset. Thorax carried by mocap, gravity off, game-scale key force. Not pixel transcription, not connectome.",
  "seed": 0,
  "total_timesteps": 5000000,
  "n_envs": 8,
  "subproc": true,
  "device": "cpu",
  "tokens": {"min_len": 3, "max_len": 8},
  "env": {
    "steps_per_char": 150,
    "base_steps": 100,
    "terminate_on_error": true,
    "speed_fraction": 0.7,
    "reward": {"correct": 1.0, "wrong": -1.0, "shift": 0.5, "complete": 2.0, "time": -0.002, "shaping": 1.0}
  },
  "curriculum": [
    {"until_fraction": 0.1, "pool": "chars"},
    {"until_fraction": 0.3, "pool": "train", "max_len": 4},
    {"until_fraction": 1.0, "pool": "train", "max_len": 8}
  ],
  "imitation": {
    "episodes": 400,
    "noisy_fraction": 0.5,
    "action_noise": 0.3,
    "epochs": 30,
    "batch_size": 1024,
    "learning_rate": 0.001,
    "log_std_after": -1.2
  },
  "policy": {"type": "mlp"},
  "ppo": {
    "learning_rate": 0.0001,
    "n_steps": 1024,
    "batch_size": 2048,
    "n_epochs": 5,
    "gamma": 0.995,
    "gae_lambda": 0.95,
    "clip_range": 0.1,
    "ent_coef": 0.0,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "policy_kwargs": {"net_arch": {"pi": [256, 256], "vf": [256, 256]}}
  },
  "eval": {"freq_timesteps": 250000, "episodes": 30},
  "checkpoint_freq_timesteps": 500000,
  "gate": {"heldout_exact_match": 0.9, "episodes": 100, "seeds": 5}
}
